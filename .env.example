# Copie ce fichier en `.env` pour le développement local (le fichier .env n'est jamais commité).

# Mode développement : pages d'erreur détaillées, fichiers statiques non hashés.
# En production (Render), NE PAS définir cette variable (ou DEBUG=False).
DEBUG=True

# Obligatoire en production. Génère-en une avec :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# SECRET_KEY=

# --- Base de données ---
# Production (Neon) : obligatoire quand DEBUG est désactivé.
# DATABASE_URL=
# Développement local : PostgreSQL (valeurs par défaut entre parenthèses).
# DB_NAME=atelier_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- Production (à définir sur Render) ---
# Nom(s) de domaine personnalisé(s), séparés par des virgules.
# ALLOWED_HOSTS=
# Adresse de l'administration, non devinable (ex. gestion-x7k2p/). Défaut : admin/
# ADMIN_URL=
# Durée HSTS en secondes (défaut 30 jours ; 31536000 = 1 an une fois tout validé).
# SECURE_HSTS_SECONDS=

# --- E-mails (Brevo) ---
# BREVO_SMTP_KEY=
# Identifiant SMTP Brevo.
# EMAIL_HOST_USER=
# Adresse d'expédition, sur votre propre domaine authentifié chez Brevo.
# DEFAULT_FROM_EMAIL=

# --- Assistant IA (saisie des mesures et des opérations) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# --- Photos (Cloudinary) ---
# CLOUDINARY_URL=

# --- Protection des données ---
# Coordonnées affichées sur la fiche d'information remise aux clientes (obligatoire pour l'imprimer)
# CONTACT_CONFIDENTIALITE=contact@exemple.com
# ATELIER_NOM=Cohen Haute Couture
# CONSERVATION_ANNEES_INACTIVITE=3
