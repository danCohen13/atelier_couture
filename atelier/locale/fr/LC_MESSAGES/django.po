msgstr "Questions fréquentes"

msgid "Combien ça coûte ?"
msgstr "Combien ça coûte ?"

msgid ""
"C'est gratuit pendant le lancement, et nous ne demandons aucune carte "
"bancaire."
msgstr ""
"C'est gratuit pendant le lancement, et nous ne demandons aucune carte "
"bancaire."

msgid "Pourquoi faut-il une invitation ?"
msgstr "Pourquoi faut-il une invitation ?"

msgid ""
"Nous ouvrons les ateliers un par un pour bien accompagner chacun au "
"démarrage. Demandez votre invitation ci-dessous : elle arrive par e-mail."
msgstr ""
"Nous ouvrons les ateliers un par un pour bien accompagner chacun au "
"démarrage. Demandez votre invitation ci-dessous : elle arrive par e-mail."

msgid "Ça marche sur téléphone ?"
msgstr "Ça marche sur téléphone ?"

msgid ""
"Oui. Le site s'adapte à l'écran du téléphone, de la tablette et de "
"l'ordinateur, sans rien installer."
msgstr ""
"Oui. Le site s'adapte à l'écran du téléphone, de la tablette et de "
"l'ordinateur, sans rien installer."

