msgstr "Un atelier, un espace"

msgid ""
"Chaque atelier ne voit que ses propres clientes. Aucun autre atelier ne peut"
" les lire ni les modifier."
msgstr ""
"Chaque atelier ne voit que ses propres clientes. Aucun autre atelier ne peut"
" les lire ni les modifier."

msgid "Fiche d'information et effacement"
msgstr "Fiche d'information et effacement"

msgid ""
"Remettez la fiche d'information à chaque cliente, et effacez ses données "
"quand elle le demande."
msgstr ""
"Remettez la fiche d'information à chaque cliente, et effacez ses données "
"quand elle le demande."

msgid "Dossiers inactifs"
msgstr "Dossiers inactifs"

msgid ""
"Les clientes sans activité depuis des années vous sont signalées, pour les "
"anonymiser en un geste."
msgstr ""
"Les clientes sans activité depuis des années vous sont signalées, pour les "
"anonymiser en un geste."

